{
  "name": "dsh-novelsupport",
  "version": "0.1.0",
  "type": "module",
  "description": "Novel-writing workspace for DeepSeek Harness: a three-pane UI with map, timeline, character/place/item/organisation graph, chapter editor, full-book export and plain-text import — stored as plain files in the project.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "license": "MIT"
}
