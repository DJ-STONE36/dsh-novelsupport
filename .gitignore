# 依赖与构建产物
node_modules/
dist/
build/
*.log
pnpm-debug.log*

# pnpm 在本盘的本地缓存（当工作区与默认 store 不同盘时生成）
.pnpm-store/

# 本地验证产物：tools/live-check.mjs 默认往这里写一个临时项目
.verify/

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# DSH 本地运行态（会话、缓存、临时文件）
.dsh/sessions/
.dsh/storage/
.dsh/cache/
*.tmp
*~

# 作者的本地作品数据（设定、大纲、正文、地图）。它只属于作者本人：
# 不进版本库、不随 clone 分发、也永远不会被 npm 包包含。
# 插件本身在 novel/ 之外；测试一律用临时目录，所以忽略它不影响任何自测。
novel/

# 构建产物与插件的自动备份（可随时重新生成，不该进版本库）
*.tgz
*.prev
*.bak-*
